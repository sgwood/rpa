# Generate with: openssl rand -base64 32
AI_RPA_DATA_KEY=replace-with-a-base64-encoded-32-byte-key

# Use at least 24 random characters. This is the first central-console admin token.
AI_RPA_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Only used by the all-in-one Beta compose file.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Optional image and loopback port overrides.
AI_RPA_IMAGE=ai-rpa-central:local
AI_RPA_HOST_BIND=127.0.0.1
AI_RPA_PORT=8080
AI_RPA_POSTGRES_PORT=15432
RUST_LOG=ai_rpa_server=info,tower_http=info

# Required only with docker-compose.rds.yml; use the ctyun RDS private endpoint.
DATABASE_URL=postgres://ai_rpa:replace-with-rds-password@private-rds-host:5432/ai_rpa
