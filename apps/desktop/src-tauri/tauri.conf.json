{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 任务中控台",
  "version": "0.1.0",
  "identifier": "com.stargold.ai-rpa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI 任务中控台",
        "width": 1440,
        "height": 1024,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3847 ws://127.0.0.1:3847; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Monitor and continue AI coding tasks",
    "longDescription": "Cross-platform task console for Codex, Claude, Cursor and Antigravity"
  }
}
